{
  "name": "hugjuulai-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hugjuulai: a school operations system (сургалтын үйл ажиллагааны систем) on erxes. AI-ranked tasks with guides, class progress, and school issue reporting with AI triage, powered by Gemma 4.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "pnpm --filter hugjuulai_demo_api start",
    "dev:api": "pnpm --filter hugjuulai_demo_api dev",
    "test": "pnpm --filter hugjuulai_demo_api test",
    "check": "pnpm --filter hugjuulai_demo_api check",
    "mock": "pnpm --filter hugjuulai_demo_api mock",
    "reset": "node -e \"require('fs').rmSync('data/db.json',{force:true})\""
  },
  "packageManager": "pnpm@10.33.2"
}
