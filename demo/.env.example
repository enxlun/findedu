# Hugjuulai — paste your two API keys below, save, then run `npm start`.
# Lines must look exactly like  NAME=value  (no spaces around =, no quotes).

PORT=3000

# ---- 1) Gemma 4 via the Gemini API -------------------------------------------
# Used for: AI small steps + learning help (TaskMind), ProblemHunt sorting,
#           teacher-rating summaries and tone checks.
# Free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemma-4-26b-a4b-it
# "minimal" = faster answers, "high" = Gemma 4 thinks longer
AI_THINKING=minimal

# ---- 2) Gemma 4 on DigitalOcean (Gradient AI serverless inference) ------------
# Used for: AI prioritization — Begin and the AI-sorted TaskMind Inbox.
# Key: DigitalOcean control panel → Serverless inference → Model access keys
#      → Create model access key (shown only once, copy it).
DO_API_KEY=
DO_MODEL=gemma-4-31B-it

# If only one key is filled in, that provider does everything.
# If a provider fails, the other one is tried, then the rule-based fallback.

# ---- Optional ------------------------------------------------------------------
# DO_BASE_URL=https://inference.do-ai.run/v1
# AI_PROVIDER=digitalocean # run everything on DigitalOcean (then AI_API_KEY may stay empty)
# AI_PROVIDER=openai       # your own Gemma 4 server (Ollama / vLLM):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=gemma4:e4b
# AI_PROVIDER=none         # no AI at all: rule-based everything
# AI_TIMEOUT_MS=60000
# AI_JSON_MODE=true
# DB_PATH=./data/db.json
